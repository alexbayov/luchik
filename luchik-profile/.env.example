# Лучик — переменные окружения
# Скопируйте в .env и заполните реальными значениями

# ── LLM Provider Keys ──────────────────────────────────
KIMCHI_API_KEY=YOUR_KIMCHI_KEY_HERE
OPENMODEL_API_KEY=YOUR_OPENMODEL_KEY_HERE
MODELHUB_API_KEY=YOUR_MODELHUB_KEY_HERE

# ── Дополнительные провайдеры ──────────────────────────
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
FIREWORKS_API_KEY=YOUR_FIREWORKS_KEY_HERE

# ── Telegram (опционально) ─────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_ALLOWED_USERS=YOUR_TELEGRAM_USER_ID

# ── Terminal ───────────────────────────────────────────
TERMINAL_TIMEOUT=120
TERMINAL_LIFETIME_SECONDS=600

# ── Browser (опционально, если включен browser toolset) ──
# AGENT_BROWSER_EXECUTABLE_PATH=
# BROWSER_SESSION_TIMEOUT=1800
# BROWSER_INACTIVITY_TIMEOUT=300
